{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022"],
    "outDir": "dist",
    "rootDir": ".",
    "strict": true,
    "noUnusedLocals": true,
    "noImplicitOverride": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "allowImportingTsExtensions": false,
    "types": ["node"]
  },
  "include": ["src/**/*.ts", "prisma/**/*.ts"],
  // Tests are never emitted, and the integration suite deliberately imports the
  // worker's processor to verify the cross-service contract. That breaks rootDir,
  // so tests are type-checked by tsconfig.test.json instead.
  "exclude": ["src/**/*.test.ts", "src/test/**"]
}
