{
  "name": "@hirefo/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "dist/src/server.js",
  "scripts": {
    "dev": "node ../../scripts/with-env.mjs npx tsx watch --clear-screen=false src/server.ts",
    "build": "prisma generate && tsc -p tsconfig.json",
    "start": "node ../../scripts/with-env.mjs node dist/src/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "db:generate": "prisma generate",
    "db:migrate": "node ../../scripts/with-env.mjs npx prisma migrate dev",
    "db:deploy": "node ../../scripts/with-env.mjs npx prisma migrate deploy",
    "db:reset": "node ../../scripts/with-env.mjs npx prisma migrate reset --force",
    "db:seed": "node ../../scripts/with-env.mjs npx tsx prisma/seed.ts",
    "db:studio": "node ../../scripts/with-env.mjs npx prisma studio",
    "test": "HIREFO_ENV_FILE=.env.test node ../../scripts/with-env.mjs npx vitest run",
    "test:watch": "HIREFO_ENV_FILE=.env.test node ../../scripts/with-env.mjs npx vitest",
    "test:setup": "HIREFO_ENV_FILE=.env.test node ../../scripts/with-env.mjs npx prisma migrate deploy"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@hirefo/shared": "*",
    "@prisma/client": "6.2.1",
    "bcryptjs": "2.4.3",
    "bullmq": "5.34.10",
    "cookie-parser": "1.4.7",
    "cors": "2.8.5",
    "express": "4.21.2",
    "express-rate-limit": "7.5.0",
    "helmet": "8.0.0",
    "ioredis": "5.4.2",
    "jsonwebtoken": "9.0.2",
    "nanoid": "5.0.9",
    "pino": "9.6.0",
    "pino-http": "10.4.0",
    "socket.io": "4.8.1",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "2.4.6",
    "@types/cookie-parser": "1.4.8",
    "@types/cors": "2.8.17",
    "@types/express": "4.17.21",
    "@types/jsonwebtoken": "9.0.7",
    "@types/node": "22.10.5",
    "@types/supertest": "6.0.2",
    "prisma": "6.2.1",
    "socket.io-client": "4.8.1",
    "supertest": "7.0.0",
    "tsx": "4.19.2",
    "typescript": "5.7.3",
    "vitest": "2.1.8"
  }
}
