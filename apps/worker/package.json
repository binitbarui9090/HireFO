{
  "name": "@hirefo/worker",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "dev": "node ../../scripts/with-env.mjs npx tsx watch --clear-screen=false src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node ../../scripts/with-env.mjs node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "HIREFO_ENV_FILE=.env.test node ../../scripts/with-env.mjs npx vitest run"
  },
  "dependencies": {
    "@hirefo/shared": "*",
    "@prisma/client": "6.2.1",
    "bullmq": "5.34.10",
    "ioredis": "5.4.2",
    "pino": "9.6.0",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@types/node": "22.10.5",
    "tsx": "4.19.2",
    "typescript": "5.7.3",
    "vitest": "2.1.8"
  }
}
