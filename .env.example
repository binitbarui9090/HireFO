# ---------------------------------------------------------------------------
# HireFO environment. Copy to .env and adjust. Never commit .env.
#   cp .env.example .env
# Generate secrets with:  openssl rand -base64 48
# ---------------------------------------------------------------------------

# --- Runtime ---------------------------------------------------------------
NODE_ENV=development
PORT=4000
HOST=127.0.0.1
LOG_LEVEL=info
# Set true only when running behind a trusted reverse proxy (reads X-Forwarded-For).
TRUST_PROXY=false

# --- Datastores ------------------------------------------------------------
# Ports match docker-compose.yml. Change both if they clash with other projects.
DATABASE_URL=postgresql://hirefo:hirefo@127.0.0.1:55439/hirefo?schema=public
REDIS_URL=redis://127.0.0.1:56389

# --- Web app / CORS --------------------------------------------------------
# Comma-separated list of browser origins allowed to call the API.
WEB_ORIGIN=http://localhost:5173
# Used to build invitation links that are shown to the inviter.
WEB_PUBLIC_URL=http://localhost:5173

# --- Authentication --------------------------------------------------------
# REQUIRED. Minimum 32 characters each. Must differ from one another.
JWT_ACCESS_SECRET=replace-me-with-at-least-32-random-characters-aaaa
JWT_REFRESH_SECRET=replace-me-with-a-different-32-plus-random-string-bbbb
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
# Must be true in production (enforced at boot).
COOKIE_SECURE=false
# COOKIE_DOMAIN=.example.com

# --- Code execution --------------------------------------------------------
# DOCKER           → every submission runs in a throwaway, network-less container
#                    with cpu/memory/pids limits and a read-only root filesystem.
# LOCAL_SUBPROCESS → DEVELOPMENT-ONLY fallback when no Docker daemon is present.
#                    Weaker isolation; the API refuses to boot with this in
#                    production. See docs/SECURITY.md.
EXECUTION_RUNNER=DOCKER
EXECUTION_QUEUE_NAME=hirefo-execution
# How many submissions the worker runs in parallel.
EXECUTION_CONCURRENCY=2

# --- AI copilot ------------------------------------------------------------
# anthropic | openai | disabled
# With `disabled` the copilot endpoints stay reachable and return a clearly
# labelled "copilot unavailable" payload — no fabricated model output.
AI_PROVIDER=disabled
AI_API_KEY=
# anthropic example: claude-opus-5 | openai example: gpt-4o
AI_MODEL=claude-opus-5
# Override for OpenAI-compatible gateways (Azure, OpenRouter, vLLM, Ollama...).
# AI_BASE_URL=https://api.openai.com/v1
AI_MAX_OUTPUT_TOKENS=2000
AI_TIMEOUT_MS=60000
# USD per million tokens — used for the cost column in AI usage tracking.
AI_PRICE_INPUT_PER_MTOK=0
AI_PRICE_OUTPUT_PER_MTOK=0
# Per-organization daily spend ceiling in USD. 0 disables the check.
AI_DAILY_BUDGET_USD=5

# --- Frontend (Vite) -------------------------------------------------------
VITE_API_URL=http://localhost:4000
