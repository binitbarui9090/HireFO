{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm install && npm run build -w @hirefo/shared && npm run build -w @hirefo/web",
  "outputDirectory": "apps/web/dist",
  "framework": null,
  "rewrites": [
    {
      "source": "/((?!assets/|api/|socket\\.io/).*)",
      "destination": "/index.html"
    }
  ]
}
